      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Air Control can pair but can't move the cursor yet."
          }
        }
      }
    },
    "E-MAC-LOCALNET.title": {
      "comment": "spec §9 E-MAC-LOCALNET",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local network access is off for Air Control."
          }
        }
      }
    },
    "E-MAC-LOCALNET.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices can't discover this Mac; QR pairing still works."
          }
        }
      }
    },
    "E-MAC-FIREWALL.title": {
      "comment": "spec §9 E-MAC-FIREWALL",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoming connections may be blocked by the firewall."
          }
        }
      }
    },
